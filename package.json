{
  "name": "crm-suite",
  "version": "1.0.0",
  "private": true,
  "description": "CRM empresarial completo - backend Express + Drizzle + PostgreSQL, frontend React + Vite",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"blue,magenta\" \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run build --workspace=server && npm run build --workspace=web",
    "test": "npm run test --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "setup": "npm run db:migrate && npm run db:seed",
    "configurar": "node scripts/configurar.mjs",
    "compartir": "node scripts/compartir.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
