# ---------------------------------------------------------------------------
# Entorno de ejecución
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Origen(es) permitidos para CORS, separados por coma
CORS_ORIGIN=http://localhost:5173
# URL pública del frontend (usada en enlaces de notificaciones)
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://crm_user:CAMBIAR_PASSWORD@localhost:5432/crm_db

# ---------------------------------------------------------------------------
# Seguridad (GENERE VALORES ÚNICOS: openssl rand -base64 48)
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=cambie-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=cambie-tambien-este-valor-por-otro-aleatorio-distinto-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# Intentos fallidos antes de bloquear temporalmente la cuenta
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# ---------------------------------------------------------------------------
# Almacenamiento de archivos
# ---------------------------------------------------------------------------
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=15

# ---------------------------------------------------------------------------
# Usuario administrador inicial (solo se usa en el seed)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@crm.local
SEED_ADMIN_PASSWORD=Admin*2026Seguro
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Administrador
# Cargar datos comerciales de ejemplo (true/false)
SEED_DEMO_DATA=false

# ---------------------------------------------------------------------------
# Registro
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Despliegues sin acceso a terminal (Cloud Run, Render y similares)
# Aplican migraciones y datos iniciales durante el arranque. Ambas operaciones
# son idempotentes, pero conviene desactivarlas una vez el sistema esté estable.
# ---------------------------------------------------------------------------
RUN_MIGRATIONS_ON_START=false
RUN_SEED_ON_START=false
